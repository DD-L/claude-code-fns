{
  "permissions": {
    "allow": [
      "Skill(fn_continue)",
      "Bash(powershell:*)",
      "Bash(echo:*)",
      "Bash(test:*)",
      "Bash(python scripts/resolve_fn.py:*)",
      "Bash(.scripts/stack_ops.ps1)",
      "Bash(python:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File scripts/session_start.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File scripts/check_chain.ps1"
          }
        ]
      }
    ]
  }
}
