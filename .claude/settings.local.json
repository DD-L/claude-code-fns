{
  "permissions": {
    "allow": [
      "Skill(fn_continue)",
      "Bash(powershell:*)",
      "Bash(echo:*)",
      "Bash(test:*)",
      "Bash(python scripts/resolve_fn.py:*)",
      "Bash(python:*)",
      "Bash(ls -la scripts/state*.json)",
      "Bash(ls -la scripts/states/*.json)",
      "Bash(ls \"C:/Users/LiNan/.claude/projects/G--gpt-cc-function\"/*.jsonl)",
      "Bash(ls -lt *.jsonl)",
      "Bash(bash scripts/wait_for_status.sh)",
      "Bash(PYTHONIOENCODING=utf-8 python -u scripts/interactive_wrapper.py scripts/interactive_test.py)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File scripts/session_start.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File scripts/check_chain.ps1"
          }
        ]
      }
    ]
  }
}
