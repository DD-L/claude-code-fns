{
  "name": "fix_issues",
  "description": "修复代码审查中发现的问题",
  "params": ["target", "issues"],
  "task": "修复 $target 中的问题：\n1. 逐个处理 $issues 中的问题\n2. 实施修复并验证\n3. 输出修复总结\n\n设置 need_test = true/false 表示是否需要运行测试",
  "tools": ["Read", "Write", "Edit", "Grep"],
  "on_complete": {
    "type": "switch",
    "cases": [
      {
        "case": "need_test == true",
        "then": {"call": "run_tests", "args": {"target": "$target"}}
      },
      {
        "case": "need_test == false",
        "then": {"type": "return"}
      }
    ],
    "default": {"type": "return"}
  }
}
