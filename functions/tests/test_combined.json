{
  "name": "test_combined",
  "description": "综合测试 - 结合分支、序列、循环的复杂场景",
  "params": ["mode", "count"],
  "task": "Bash(echo \"[test_combined] mode=$mode, count=$count\")",
  "tools": ["Bash"],
  "on_complete": {
    "type": "switch",
    "cases": [
      {
        "case": "$mode == 'sequence'",
        "then": {"call": "test_sequence", "args": {"input": "combined_$count"}}
      },
      {
        "case": "$mode == 'loop'",
        "then": {"call": "test_loop", "args": {"count": 0, "max": "$count"}}
      },
      {
        "case": "$mode == 'recursion'",
        "then": {"call": "test_recursion", "args": {"n": "$count"}}
      },
      {
        "case": "$mode == 'tail'",
        "then": {"tail_call": "test_tail_recursion", "args": {"n": "$count"}}
      }
    ],
    "default": {"type": "return"}
  }
}
