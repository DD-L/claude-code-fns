{
  "name": "test_branch",
  "description": "测试分支(switch) - 根据 mode 选择不同路径",
  "params": ["mode"],
  "task": "Bash(echo \"[test_branch] mode=$mode\")",
  "tools": ["Bash"],
  "on_complete": {
    "type": "switch",
    "cases": [
      {
        "case": "$mode == 'A'",
        "then": {"call": "branch_handler_a", "args": {"from": "test_branch"}}
      },
      {
        "case": "$mode == 'B'",
        "then": {"tail_call": "branch_handler_b", "args": {"from": "test_branch"}}
      },
      {
        "case": "$mode == 'C'",
        "then": {"type": "return"}
      }
    ],
    "default": {"type": "return"}
  }
}
