{
  "name": "test_tail_recursion",
  "description": "测试尾递归 - 使用 tail_call，栈深度恒为 1",
  "params": ["n"],
  "task": "Bash(echo \"[test_tail_recursion] n=$n\")",
  "tools": ["Bash"],
  "on_complete": {
    "type": "switch",
    "cases": [
      {
        "case": "$n <= 0",
        "then": {"type": "return", "value": "done"}
      },
      {
        "case": "$n > 0",
        "then": {"tail_call": "test_tail_recursion", "args": {"n": "$n - 1"}}
      }
    ],
    "default": {"type": "return"}
  }
}
