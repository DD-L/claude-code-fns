{
  "name": "test_sequence_4steps",
  "description": "测试4步序列(sequence) - 验证所有步骤都执行，不跳步",
  "params": ["input"],
  "task": "Bash(echo \"[test_sequence_4steps] input=$input\")",
  "tools": ["Bash"],
  "on_complete": {
    "type": "sequence",
    "steps": [
      {"call": "seq_step1", "args": {"data": "$input"}},
      {"call": "seq_step2", "args": {"data": "$prev"}},
      {"call": "seq_step3", "args": {"data": "$prev"}},
      {"tail_call": "seq_step4", "args": {"data": "$prev"}}
    ]
  }
}
