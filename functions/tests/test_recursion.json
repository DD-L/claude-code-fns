{
  "name": "test_recursion",
  "description": "测试递归 - 使用 call 实现真正的递归，栈深度增长",
  "params": ["n"],
  "task": "Bash(echo \"[test_recursion] n=$n, entering...\")",
  "tools": ["Bash"],
  "on_complete": {
    "type": "switch",
    "cases": [
      {
        "case": "$n <= 0",
        "then": {"type": "return", "value": "base_case"}
      },
      {
        "case": "$n > 0",
        "then": {"call": "test_recursion", "args": {"n": "$n - 1"}}
      }
    ],
    "default": {"type": "return"}
  }
}
