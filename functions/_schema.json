{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Function Definition Schema",
  "description": "定义 function-skill 的 JSON schema",
  "type": "object",
  "required": ["name", "task"],
  "definitions": {
    "function_ref": {
      "type": "string",
      "description": "函数引用，支持多种语法",
      "examples": [
        "validate",
        "examples/validate",
        "./validate",
        "../route_a",
        "_return",
        "_compact"
      ],
      "pattern": "^(_[a-z]+|[.]{1,2}/)?[a-zA-Z0-9_/]+$"
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "description": "function 的短名（不含命名空间）"
    },
    "description": {
      "type": "string",
      "description": "function 的描述"
    },
    "params": {
      "type": "array",
      "items": {"type": "string"},
      "description": "参数名列表"
    },
    "task": {
      "oneOf": [
        {
          "type": "string",
          "description": "任务提示词（简化写法，等价于 execute_in: main）"
        },
        {
          "type": "object",
          "description": "任务定义对象（完整写法）",
          "required": ["prompt"],
          "properties": {
            "prompt": {
              "type": "string",
              "description": "任务提示词，可使用 $param_name 引用参数"
            },
            "tools": {
              "type": "array",
              "items": {"type": "string"},
              "description": "此 task 可使用的工具列表（覆盖顶层 tools）"
            },
            "execute_in": {
              "type": "string",
              "description": "执行位置: main(默认), subagent, subagent@haiku, subagent@sonnet, subagent@opus",
              "pattern": "^(main|subagent(@(haiku|sonnet|opus))?)$",
              "default": "main"
            }
          }
        }
      ],
      "description": "任务定义，可以是字符串（简化）或对象（完整）"
    },
    "tools": {
      "type": "array",
      "items": {"type": "string"},
      "description": "可使用的工具列表（渐进式暴露）"
    },
    "on_complete": {
      "type": "object",
      "description": "完成后的行为",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["return", "call", "tail_call", "switch", "sequence", "loop"],
          "description": "动作类型"
        },
        "target": {
          "$ref": "#/definitions/function_ref",
          "description": "目标函数引用（call/tail_call 使用），支持: 短名、绝对路径(ns/name)、相对路径(./name, ../name)"
        },
        "args": {
          "type": "object",
          "description": "传递给目标的参数"
        },
        "conditions": {
          "type": "array",
          "description": "条件分支列表（switch 使用）",
          "items": {
            "type": "object",
            "properties": {
              "when": {"type": "string", "description": "条件表达式"},
              "type": {"type": "string", "enum": ["return"]},
              "call": {"$ref": "#/definitions/function_ref"},
              "tail_call": {"$ref": "#/definitions/function_ref"},
              "args": {"type": "object"}
            },
            "required": ["when"]
          }
        },
        "default": {
          "$ref": "#/definitions/function_ref",
          "description": "默认动作: _return 或函数引用"
        },
        "default_args": {
          "type": "object",
          "description": "默认动作的参数"
        },
        "steps": {
          "type": "array",
          "description": "序列步骤（sequence 使用）",
          "items": {
            "type": "object",
            "properties": {
              "call": {"$ref": "#/definitions/function_ref"},
              "tail_call": {"$ref": "#/definitions/function_ref"},
              "args": {"type": "object"}
            }
          }
        },
        "while": {
          "type": "string",
          "description": "循环条件（loop 使用）"
        },
        "do": {
          "type": "object",
          "description": "循环体（loop 使用，只能用 tail_call）",
          "properties": {
            "tail_call": {"$ref": "#/definitions/function_ref"},
            "args": {"type": "object"}
          },
          "required": ["tail_call"],
          "additionalProperties": false
        },
        "max_iterations": {
          "type": "number",
          "description": "最大循环次数",
          "default": 1000
        }
      }
    }
  }
}
