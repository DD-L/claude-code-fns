{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Function Definition Schema",
  "description": "定义 function-skill 的 JSON schema",
  "type": "object",
  "required": ["name", "task"],
  "definitions": {
    "function_ref": {
      "type": "string",
      "description": "函数引用，支持多种语法",
      "examples": [
        "validate",
        "examples/validate",
        "./validate",
        "../route_a",
        "_return",
        "_compact"
      ],
      "pattern": "^(_[a-z]+|[.]{1,2}/)?[a-zA-Z0-9_/]+$"
    },
    "action": {
      "type": "object",
      "description": "动作定义（用于 switch case 的 then 和 default）",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["return"],
          "description": "返回动作"
        },
        "value": {
          "description": "返回值（type=return 时使用）"
        },
        "call": {
          "$ref": "#/definitions/function_ref",
          "description": "调用函数（返回后继续）"
        },
        "tail_call": {
          "$ref": "#/definitions/function_ref",
          "description": "尾调用函数（不返回）"
        },
        "args": {
          "type": "object",
          "description": "传递给函数的参数"
        }
      }
    },
    "case_item": {
      "type": "object",
      "description": "switch 分支项（新语法）",
      "properties": {
        "case": {
          "type": "string",
          "description": "条件表达式"
        },
        "then": {
          "$ref": "#/definitions/action",
          "description": "条件为真时执行的动作"
        },
        "default": {
          "$ref": "#/definitions/action",
          "description": "默认动作（无需 case 条件）"
        }
      }
    },
    "condition_item": {
      "type": "object",
      "description": "switch 条件项（旧语法，已废弃）",
      "properties": {
        "when": {"type": "string", "description": "条件表达式"},
        "type": {"type": "string", "enum": ["return"]},
        "call": {"$ref": "#/definitions/function_ref"},
        "tail_call": {"$ref": "#/definitions/function_ref"},
        "args": {"type": "object"}
      },
      "required": ["when"],
      "deprecated": true
    },
    "trigger_rule": {
      "type": "object",
      "description": "triggers 规则项（NFA 多分支语义）",
      "properties": {
        "when": {
          "type": "string",
          "description": "触发条件（可以是语义表达式）"
        },
        "do": {
          "$ref": "#/definitions/action",
          "description": "条件为真时执行的动作"
        }
      },
      "required": ["when", "do"]
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "description": "function 的短名（不含命名空间）"
    },
    "description": {
      "type": "string",
      "description": "function 的描述"
    },
    "params": {
      "type": "array",
      "items": {"type": "string"},
      "description": "参数名列表"
    },
    "task": {
      "oneOf": [
        {
          "type": "string",
          "description": "任务提示词（简化写法，等价于 execute_in: main）"
        },
        {
          "type": "object",
          "description": "任务定义对象（完整写法）",
          "required": ["prompt"],
          "properties": {
            "prompt": {
              "type": "string",
              "description": "任务提示词，可使用 $param_name 引用参数"
            },
            "tools": {
              "type": "array",
              "items": {"type": "string"},
              "description": "此 task 可使用的工具列表（覆盖顶层 tools）"
            },
            "execute_in": {
              "type": "string",
              "description": "执行位置: main(默认), subagent, subagent@haiku, subagent@sonnet, subagent@opus",
              "pattern": "^(main|subagent(@(haiku|sonnet|opus))?)$",
              "default": "main"
            }
          }
        }
      ],
      "description": "任务定义，可以是字符串（简化）或对象（完整）"
    },
    "tools": {
      "type": "array",
      "items": {"type": "string"},
      "description": "可使用的工具列表（渐进式暴露）"
    },
    "on_complete": {
      "type": "object",
      "description": "完成后的行为",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["return", "call", "tail_call", "switch", "triggers", "sequence", "loop"],
          "description": "动作类型"
        },
        "target": {
          "$ref": "#/definitions/function_ref",
          "description": "目标函数引用（call/tail_call 使用），支持: 短名、绝对路径(ns/name)、相对路径(./name, ../name)"
        },
        "args": {
          "type": "object",
          "description": "传递给目标的参数"
        },
        "value": {
          "description": "返回值（type=return 时使用）"
        },
        "cases": {
          "type": "array",
          "description": "条件分支列表（switch 新语法：case/then/default）",
          "items": {
            "$ref": "#/definitions/case_item"
          }
        },
        "conditions": {
          "type": "array",
          "description": "条件分支列表（switch 旧语法，已废弃，请使用 cases）",
          "items": {
            "$ref": "#/definitions/condition_item"
          },
          "deprecated": true
        },
        "default": {
          "oneOf": [
            {"$ref": "#/definitions/function_ref"},
            {"$ref": "#/definitions/action"}
          ],
          "description": "默认动作: _return、函数引用或 action 对象"
        },
        "default_args": {
          "type": "object",
          "description": "默认动作的参数（与 default 为函数引用时配合使用）"
        },
        "steps": {
          "type": "array",
          "description": "序列步骤（sequence 使用）",
          "items": {
            "type": "object",
            "properties": {
              "call": {"$ref": "#/definitions/function_ref"},
              "tail_call": {"$ref": "#/definitions/function_ref"},
              "args": {"type": "object"}
            }
          }
        },
        "while": {
          "type": "string",
          "description": "循环条件（loop 使用）"
        },
        "do": {
          "type": "object",
          "description": "循环体（loop 使用，只能用 tail_call）",
          "properties": {
            "tail_call": {"$ref": "#/definitions/function_ref"},
            "args": {"type": "object"}
          },
          "required": ["tail_call"],
          "additionalProperties": false
        },
        "max_iterations": {
          "type": "number",
          "description": "最大循环次数",
          "default": 1000
        },
        "rules": {
          "type": "array",
          "description": "触发器规则列表（triggers 使用，NFA 语义：所有匹配的规则都执行）",
          "items": {
            "$ref": "#/definitions/trigger_rule"
          }
        },
        "on_none": {
          "$ref": "#/definitions/action",
          "description": "无规则匹配时的动作（triggers 使用）"
        }
      }
    }
  }
}
