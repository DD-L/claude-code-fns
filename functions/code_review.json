{
  "name": "code_review",
  "description": "审查代码质量、安全性和性能问题",
  "params": ["target", "review_type"],
  "task": "对 $target 进行 $review_type 类型的代码审查：\n1. 读取目标代码\n2. 分析问题（security/performance/quality）\n3. 输出问题列表和改进建议\n\n设置 need_fix = true/false 表示是否需要修复",
  "tools": ["Read", "Grep", "Glob"],
  "on_complete": {
    "type": "switch",
    "conditions": [
      {
        "when": "need_fix == true",
        "call": "fix_issues",
        "args": {"target": "$target", "issues": "$issues"}
      },
      {
        "when": "need_fix == false",
        "type": "return"
      }
    ],
    "default": "_return"
  }
}
