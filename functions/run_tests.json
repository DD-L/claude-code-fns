{
  "name": "run_tests",
  "description": "运行测试验证修复结果",
  "params": ["target"],
  "task": "运行 $target 相关的测试：\n1. 检测测试框架\n2. 运行测试\n3. 分析结果\n\n设置 test_passed = true/false",
  "tools": ["Bash", "Read"],
  "on_complete": {
    "type": "switch",
    "cases": [
      {
        "case": "test_passed == false",
        "then": {"call": "fix_issues", "args": {"target": "$target", "issues": "$failures"}}
      },
      {
        "case": "test_passed == true",
        "then": {"type": "return"}
      }
    ],
    "default": {"type": "return"}
  }
}
