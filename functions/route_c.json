{
  "name": "route_c",
  "description": "动态路由函数 C - 根据 n 和 from 决定路径",
  "params": ["n", "from"],
  "task": "使用 echo 输出: [C] n=$n, from=$from",
  "tools": ["Bash"],
  "on_complete": {
    "type": "switch",
    "cases": [
      {
        "case": "$n <= 0",
        "then": {"type": "return"}
      },
      {
        "case": "$from == 'A'",
        "then": {"tail_call": "route_b", "args": {"n": "$n - 1", "from": "C"}}
      },
      {
        "case": "$from == 'B'",
        "then": {"tail_call": "route_a", "args": {"n": "$n - 2"}}
      }
    ],
    "default": {"tail_call": "route_a", "args": {"n": "$n - 1"}}
  }
}
