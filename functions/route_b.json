{
  "name": "route_b",
  "description": "动态路由函数 B - 偶数走 A，奇数走 C",
  "params": ["n", "from"],
  "task": "使用 echo 输出: [B] n=$n, from=$from, next=$( if (($n % 2 == 0)); then echo A; else echo C; fi )",
  "tools": ["Bash"],
  "on_complete": {
    "type": "switch",
    "cases": [
      {
        "case": "$n <= 0",
        "then": {"type": "return"}
      },
      {
        "case": "$n % 2 == 0",
        "then": {"tail_call": "route_a", "args": {"n": "$n - 1"}}
      },
      {
        "case": "$n % 2 == 1",
        "then": {"tail_call": "route_c", "args": {"n": "$n - 1", "from": "B"}}
      }
    ],
    "default": {"type": "return"}
  }
}
